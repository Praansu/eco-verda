# EcoVerda environment — copy to `.env` and fill in values before running.
# cp .env.example .env

# SQLite file used by Prisma in local dev
DATABASE_URL="file:./dev.db"

# NextAuth session secret — generate one: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Only needed once Stripe checkout is wired up.
# src/lib/stripe.ts currently exists but nothing imports it yet.
STRIPE_SECRET_KEY=""
